{
  // Cloudflare deploy config for this static Vite/PWA build — no server-side
  // Worker code, just the built `dist/` assets. "single-page-application"
  // fallback is required because routing is client-side (react-router's
  // BrowserRouter): without it, a hard refresh or shared link to a route
  // like /participants/:id or /behaviours/:id would 404 instead of being
  // served index.html and resolved client-side.
  "name": "frame",
  "compatibility_date": "2026-08-13",
  "routes": [
    {
      "pattern": "frame.whatbit.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
