{
  "name": "screen-fba",
  "compatibility_date": "2026-08-13",
  "main": "worker/index.ts",
  "routes": [
    {
      "pattern": "frame.whatbit.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frame-auth",
      "database_id": "d8d1f54e-f635-4cea-a9d6-00d70c1004c7",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FRAME_STRIPE_MONTHLY_PRICE_ID": "price_1U9KzoFIXid8q5wwOlHFMUAV",
    "FRAME_STRIPE_ANNUAL_PRICE_ID": "price_1U9KzwFIXid8q5wwQKJUcwHH",
    "FRAME_PUBLIC_ORIGIN": "https://frame.whatbit.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
